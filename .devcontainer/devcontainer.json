// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Airsports live tracking",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"dockerComposeFile": [
		"../docker-compose.yml",
		// You can include additional override files if needed:
		"docker-compose.override.yml" 
	],
	// Specify the service VS Code should attach to
	"service": "tracker_daphne",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {
			"ppa": true,
			"version": "os-provided"
		},
		"ghcr.io/devcontainers-extra/features/curl-apt-get:1": {},
		"ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
			// "packages": "build-essential,pkg-config,cmake,curl,gdal-bin,proj-data,proj-bin,default-libmysqlclient-dev,libcliquer1,libgslcblas0,latexmk,texlive,texlive-latex-base,texlive-latex-extra,texlive-latex-recommended,ca-certificates,gnupg,watchman"
			"packages": "watchman,curl,wget,build-essential,pkg-config,cmake"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24", // Specify a Node.js version (e.g., "18", "lts", "latest")
			"nodeGypDependencies": true, // Installs common C/C++ dependencies for native modules
			"installVscodeCli": true, // Optional: installs the dev container CLI
			"npmPackages": [
				"eslint",
				"prettier"
			] // Optional: List of global npm packages to install
		}
	},
	"containerEnv": {
		"GOOGLE_APPLICATION_CREDENTIALS": "/workspace/secret/application_default_credentials.json"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.debugpy",
				"pokey.cursorless",
				"ms-python.black-formatter",
				"Anjali.clipboard-history",
				"batisteo.vscode-django",
				"ms-azuretools.vscode-docker",
				"ms-vscode.hexeditor",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"charliermarsh.ruff",
				"pokey.talon",
				"Gruntfuggly.todo-tree",
				"ms-python.python",
				"google.geminicodeassist"
			]
		}
	},
	// "postCreateCommand": "pip install cython shapely -r requirements.txt && npm install && cd react_vite && npm install && cd ../reactjs/ && npm install && cd ../src/static/css && curl -sL daisyui.com/fast | bash",
	"postCreateCommand": "cd src/static/css && curl -sL daisyui.com/fast | bash",
	"postStartCommand": "rm nohup.out && nohup bash -c 'cd react_vite && (npm run build --watch &) && cd ../reactjs && (npm run webpack-local &) && cd .. && (src/static/css/tailwindcss -i src/static/css/input.css -o src/static/css/output.css --watch &)'"
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip3 install --user -r requirements.txt",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}