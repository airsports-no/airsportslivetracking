---
// TodaysFlights.astro
---
<div id="todays-flights-container" class="mt-20 pt-16 pb-4 hidden bg-slate-50 border-y border-slate-100 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-100 rounded-full mix-blend-multiply opacity-20 filter blur-3xl"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-100 rounded-full mix-blend-multiply opacity-20 filter blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-end gap-4 mb-10">
            <div class="flex flex-col gap-2">
                <div class="flex items-center gap-3">
                    <div class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse shadow-[0_0_8px_rgba(34,197,94,0.4)]"></div>
                    <p class="text-slate-500 font-black text-[10px] uppercase tracking-[0.2em] italic">Live Tracking Active</p>
                </div>
                <div class="flex items-baseline gap-4">
                    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 font-lexend italic uppercase tracking-tight">Today's <span class="text-blue-600">Missions</span></h2>
                    <span id="current-date-display" class="text-xs font-black text-slate-400 uppercase tracking-widest font-lexend italic"></span>
                </div>
            </div>
            <p class="text-slate-500 font-medium text-sm max-w-md leading-relaxed hidden lg:block italic">Scheduled public navigation tasks and live competitor progress.</p>
        </div>

        <!-- Horizontal Scroll Container -->
        <div id="todays-tasks-list" class="flex gap-6 overflow-x-auto pb-4 snap-x custom-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
            <!-- Content injected via JS -->
        </div>
    </div>
</div>

<script>
    async function fetchTodaysFlights() {
        const container = document.getElementById('todays-flights-container');
        const list = document.getElementById('todays-tasks-list');
        const dateDisplay = document.getElementById('current-date-display');
        
        if (!container || !list || !dateDisplay) return;

        const API_BASE = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
            ? 'http://localhost:8002'
            : 'https://app.airsports.no';

        dateDisplay.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', month: 'short', day: 'numeric' });

        try {
            const response = await fetch(`${API_BASE}/api/v1/contests/todays_navigation/`);
            if (!response.ok) throw new Error('Failed to fetch');
            const data = await response.json();

            const platformSection = document.getElementById('platform-in-action');

            if (!data || data.length === 0) {
                container.classList.add('hidden');
                if (platformSection) platformSection.style.paddingTop = '';
                return;
            }

            container.classList.remove('hidden');
            if (platformSection) platformSection.style.paddingTop = '2rem';
            list.innerHTML = '';

            data.forEach(task => {
                const card = document.createElement('div');
                card.className = 'snap-start flex-shrink-0 w-[300px] md:w-[420px] bg-white rounded-[3rem] p-10 shadow-2xl shadow-slate-200/60 border border-slate-100 hover:border-blue-300 transition-all duration-500 flex flex-col relative overflow-hidden group';
                
                const sortedContestants = (task.contestants || []).sort((a, b) => new Date(a.takeoff_time).getTime() - new Date(b.takeoff_time).getTime());

                const contestantsHtml = sortedContestants.map(c => {
                    const time = new Date(c.takeoff_time).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZoneName: 'short' });
                    return `
                    <div class="flex justify-between items-center py-4 border-b border-slate-50 last:border-0 group/row">
                        <div class="flex flex-col min-w-0">
                            <span class="text-sm font-extrabold text-slate-800 tracking-tight truncate uppercase italic group-hover/row:text-blue-600 transition-colors">#${c.contestant_number} ${c.pilot_name}</span>
                            <span class="text-[10px] text-slate-400 uppercase font-black tracking-[0.1em] mt-0.5">${c.aircraft_registration}</span>
                        </div>
                        <div class="flex flex-col items-end shrink-0 ml-4">
                             <span class="font-mono text-xs font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-lg border border-blue-100">${time}</span>
                             <span class="text-[8px] text-slate-300 uppercase font-black tracking-widest mt-1">Takeoff</span>
                        </div>
                    </div>
                `}).join('');

                card.innerHTML = `
                    <!-- Decorative Background Icon -->
                    <div class="absolute -right-6 -top-6 opacity-[0.03] text-blue-900 pointer-events-none transform rotate-12 group-hover:rotate-0 transition-transform duration-1000">
                        <svg class="w-32 h-32 fill-current" viewBox="0 0 24 24"><path d="M21 16.5C21 16.88 20.79 17.21 20.47 17.38L12.57 21.82C12.41 21.94 12.21 22 12 22C11.79 22 11.59 21.94 11.43 21.82L3.53 17.38C3.21 17.21 3 16.88 3 16.5V7.5C3 7.12 3.21 6.79 3.53 6.62L11.43 2.18C11.59 2.06 11.79 2 12 2C12.21 2 12.41 2.06 12.57 2.18L20.47 6.62C20.79 6.79 21 7.12 21 7.5V16.5Z"/></svg>
                    </div>

                    <div class="mb-8 relative z-10">
                        <span class="text-[10px] font-black text-blue-600 bg-blue-50/50 px-3 py-1 rounded-full uppercase tracking-[0.2em] italic mb-3 inline-block border border-blue-100/50">${task.contest_name}</span>
                        <h3 class="text-2xl font-black text-slate-900 font-lexend italic uppercase tracking-tight leading-tight group-hover:text-blue-600 transition-colors">${task.name}</h3>
                    </div>
                    
                    <div class="flex-1 space-y-1 mb-10 max-h-80 overflow-y-auto pr-2 custom-scrollbar relative z-10">
                        ${contestantsHtml || '<p class="text-xs text-slate-400 italic">No scheduled flights found for today.</p>'}
                    </div>

                    <div class="relative z-10">
                        <a href="${API_BASE+task.tracking_link}" target="_blank" class="flex items-center justify-center gap-3 w-full bg-slate-900 text-white py-4 rounded-[1.25rem] font-black text-[10px] uppercase tracking-[0.2em] hover:bg-blue-600 hover:shadow-xl hover:shadow-blue-200 transition-all duration-500 active:scale-95 italic">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            Open Live Map
                        </a>
                    </div>
                `;
                list.appendChild(card);
            });

        } catch (e) {
            console.error('Flights fetch error:', e);
            container.classList.add('hidden');
        }
    }

    fetchTodaysFlights();
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #cbd5e1;
    }
    
    #todays-tasks-list {
        scrollbar-width: thin;
        scrollbar-color: #e2e8f0 #f8fafc;
    }
</style>
