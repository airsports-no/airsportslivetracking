---
// MissionAnimation.astro
---

<div class="py-24 bg-slate-900 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-extrabold text-white font-lexend italic mb-4 uppercase tracking-tight">The Mission Flow</h2>
            <p class="text-blue-200 text-lg max-w-2xl mx-auto font-medium">From flight order to real-time scoring and debrief.</p>
        </div>

        <div id="mission-animation-wrapper" class="relative mx-auto w-full max-w-5xl aspect-video bg-[#0f172a] rounded-3xl overflow-hidden shadow-2xl border border-white/10">
            <div id="animation-container" class="w-full h-full relative">
                <div class="scanline-overlay"></div>
                <div class="ui-overlay">
                    <div class="aslt-badge" style="border-left: 3px solid #3b82f6">ASLT MISSION FEED</div>
                    <div class="aslt-badge">REG: LN-ASL</div>
                </div>
                <div class="timestamp" id="timer">00:00:00</div>

                <!-- SCENE 1: THE BRIEFING -->
                <div id="scene1" class="scene active-scene">
                    <div class="table-surface"></div>
                    <div id="flight-order-container">
                        <div class="flex flex-col h-full border border-slate-200 p-4">
                            <div class="mb-2 h-1 w-10 bg-blue-500"></div>
                            <h1 class="text-2xl font-black tracking-tighter uppercase mb-1 text-slate-900">Flight Order</h1>
                            <p class="text-[8px] font-bold text-slate-400 tracking-widest mb-4">REF: PRECISION-V4-LOG-01</p>
                            
                            <div class="flex-grow bg-slate-50 border border-slate-200 relative overflow-hidden mb-4">
                                <svg viewBox="0 0 400 300" class="w-full h-full">
                                    <path d="M0 75 H400 M0 150 H400 M0 225 H400 M100 0 V300 M200 0 V300 M300 0 V300" stroke="#cbd5e1" stroke-width="0.5" />
                                    <path id="briefing-path" d="M50 250 C120 150 250 200 350 50" stroke="#3b82f6" stroke-width="4" stroke-linecap="round" fill="none" />
                                </svg>
                            </div>

                            <div class="flex justify-between items-end border-t border-slate-200 pt-4">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 bg-blue-500 rounded-sm"></div>
                                        <span class="text-[7px] font-bold uppercase text-slate-700">Corridor Configured</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 bg-slate-200 rounded-sm"></div>
                                        <span class="text-[7px] font-bold uppercase text-slate-700">Pilot Validation</span>
                                    </div>
                                </div>
                                <div class="border-b border-slate-900 w-24 pb-1 text-[7px] font-bold text-slate-400">SIGNATURE</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SCENE 2: THE ACTIVATION -->
                <div id="scene2" class="scene">
                    <svg viewBox="0 0 1000 562.5" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                        <rect width="1000" height="300" fill="#3b82f6" />
                        <rect y="300" width="1000" height="262.5" fill="#334155" />
                        
                        <g id="cockpit">
                            <path d="M0 562 V340 C300 280 700 280 1000 340 V562 H0 Z" fill="#0f172a" />
                            <path d="M0 340 C300 280 700 280 1000 340" stroke="#1e293b" stroke-width="6" />
                            <path d="M50 345 Q500 300 950 345" stroke="#020617" stroke-width="12" stroke-linecap="round" />

                            <g transform="translate(150, 440)">
                                <circle r="45" fill="#111827" stroke="#334155" stroke-width="3" />
                                <path d="M0 0 L-30 -20" stroke="white" stroke-width="2" />
                                <text y="25" fill="#64748b" font-size="8" text-anchor="middle" font-family="JetBrains Mono">AIRSPEED</text>
                            </g>
                            <g transform="translate(260, 440)">
                                <circle r="45" fill="#111827" stroke="#334155" stroke-width="3" />
                                <path d="M0 0 L25 -15" stroke="white" stroke-width="2" />
                                <text y="25" fill="#64748b" font-size="8" text-anchor="middle" font-family="JetBrains Mono">ALTITUDE</text>
                            </g>

                            <rect x="370" y="360" width="260" height="180" rx="4" fill="#020617" stroke="#334155" stroke-width="2" />
                            <rect x="385" y="375" width="230" height="150" fill="#0f172a" rx="2" />
                            <text x="500" y="395" fill="#3b82f6" font-size="10" text-anchor="middle" font-family="JetBrains Mono" font-weight="bold">ASLT PFD v4.0</text>
                            <path id="efis-horizon" d="M385 450 H615" stroke="#10b981" stroke-width="2" />
                            <text x="500" y="510" fill="white" font-size="8" text-anchor="middle" font-family="JetBrains Mono">HDG 240° | GS 0 KTS</text>

                            <g id="flight-yoke" transform="translate(500, 562)">
                                <rect x="-20" y="-100" width="40" height="100" fill="#1e293b" />
                                <path d="M-100 -120 Q-100 -160 -60 -160 H60 Q100 -160 100 -120 Q100 -80 60 -80 H-60 Q-100 -80 -100 -120" fill="#020617" stroke="#334155" stroke-width="4" />
                                <circle cy="-120" r="25" fill="#1e293b" stroke="#334155" stroke-width="2" />
                            </g>

                            <g id="pilot-arm">
                                <path d="M600 600 L640 420" stroke="#1e3a8a" stroke-width="70" stroke-linecap="round" />
                                <g id="phone-activation">
                                    <rect x="620" y="220" width="140" height="260" rx="20" fill="#000" stroke="#475569" stroke-width="6" />
                                    <rect id="go-button" x="640" y="360" width="100" height="50" rx="25" fill="#3b82f6" />
                                    <text x="690" y="392" fill="white" font-size="12" font-weight="800" text-anchor="middle" font-family="JetBrains Mono">START TRACK</text>
                                </g>
                            </g>
                        </g>
                    </svg>
                </div>

                <!-- SCENE 3: TACTICAL FLIGHT -->
                <div id="scene3" class="scene">
                    <svg viewBox="0 0 1000 562.5" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                        <rect width="1000" height="562.5" fill="#020617" />
                        <path d="M0 0 H1000 V562.5 H0 Z" fill="url(#mapGrid)" />
                        
                        <path d="M100 450 L300 300 L500 350 L700 150 L900 100" stroke="#3b82f6" stroke-width="80" stroke-opacity="0.08" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        <path d="M100 450 L300 300 L500 350 L700 150 L900 100" stroke="#3b82f6" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="8 8" fill="none" />
                        
                        <path id="flight-trail" d="" stroke="#3b82f6" stroke-width="4" fill="none" stroke-linecap="round" class="glow-line" />
                        
                        <g id="penalty-callout" opacity="0">
                            <rect x="-55" y="-75" width="110" height="45" rx="4" fill="#ef4444" />
                            <text x="0" y="-47" fill="white" font-size="14" font-weight="900" text-anchor="middle" font-family="JetBrains Mono">OUTSIDE</text>
                            <path d="M0 -30 L0 -5" stroke="#ef4444" stroke-width="3" />
                        </g>

                        <g id="aircraft">
                            <path d="M-18 0 H18 M0 -15 V10 M-8 8 H8" stroke="white" stroke-width="3" stroke-linecap="round" />
                            <rect x="-25" y="14" width="50" height="16" fill="#3b82f6" rx="2" />
                            <text x="0" y="25" fill="white" font-size="9" text-anchor="middle" font-weight="800" font-family="JetBrains Mono">LN-ASL</text>
                        </g>
                        
                        <g transform="translate(30, 430)">
                            <rect width="180" height="100" fill="rgba(15,23,42,0.9)" stroke="rgba(59,130,246,0.3)" rx="4" />
                            <text x="15" y="25" fill="#3b82f6" font-size="10" font-weight="800">GS: <tspan fill="white">112 KTS</tspan></text>
                            <text x="15" y="50" fill="#3b82f6" font-size="10" font-weight="800">ALT: <tspan fill="white">1300 FT</tspan></text>
                            <text x="15" y="75" fill="#3b82f6" font-size="10" font-weight="800">DEV: <tspan id="hud-dev" fill="white">0.0m</tspan></text>
                        </g>
                    </svg>
                    <defs>
                        <pattern id="mapGrid" width="60" height="60" patternUnits="userSpaceOnUse">
                            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="white" stroke-width="0.5" stroke-opacity="0.05"/>
                        </pattern>
                    </defs>
                </div>

                <!-- SCENE 4: CLUBHOUSE -->
                <div id="scene4" class="scene">
                    <svg viewBox="0 0 1000 562.5" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                        <rect width="1000" height="562.5" fill="#020617" />
                        
                        <!-- Display Wall -->
                        <rect width="700" height="350" x="150" y="60" fill="#0f172a" stroke="#334155" stroke-width="8" rx="4" />
                        <text x="500" y="100" fill="#3b82f6" font-size="16" font-weight="800" text-anchor="middle" class="glow-text">BROADCAST: LIVE TRACKING</text>
                        
                        <!-- Leaderboard Section -->
                        <g transform="translate(180, 140)">
                            <rect width="250" height="230" fill="rgba(59,130,246,0.02)" stroke="rgba(255,255,255,0.05)" rx="4" />
                            <text x="15" y="25" fill="#64748b" font-size="10" font-weight="800">LEADERBOARD</text>
                            <g transform="translate(15, 45)">
                                <rect width="220" height="30" fill="#3b82f6" opacity="0.2" rx="2" />
                                <text x="10" y="20" fill="white" font-size="12" font-weight="800">1. LN-ASL</text>
                                <text x="210" y="20" fill="#3b82f6" font-size="12" font-weight="800" text-anchor="end">2,482</text>
                            </g>
                            <g transform="translate(15, 80)">
                                <rect width="220" height="30" fill="rgba(255,255,255,0.05)" rx="2" />
                                <text x="10" y="20" fill="white" font-size="11" opacity="0.7">2. SE-FLY</text>
                                <text x="210" y="20" fill="white" font-size="11" text-anchor="end" opacity="0.7">2,110</text>
                            </g>
                        </g>

                        <!-- Mini Map Section -->
                        <g transform="translate(450, 140)">
                            <rect width="370" height="230" fill="#020617" stroke="rgba(59,130,246,0.2)" rx="4" />
                            <text x="15" y="25" fill="#64748b" font-size="10" font-weight="800">LIVE TRACKER</text>
                            <!-- Track Path scaled down -->
                            <path d="M40 180 L110 130 L180 150 L200 80 L260 70 L330 50" stroke="#3b82f6" stroke-width="2" fill="none" opacity="0.6" stroke-dasharray="4 4" />
                            <circle cx="200" cy="80" r="4" fill="#ef4444" class="glow-red" />
                            <text x="210" y="84" fill="#ef4444" font-size="8" font-weight="900">LN-ASL CLIP</text>
                        </g>

                        <!-- Refined People Silhouettes -->
                        <g id="spectator-crowd">
                            <g transform="translate(200, 520)">
                                <path d="M-40 50 Q-40 0 0 0 Q40 0 40 50 Z" fill="#0f172a" />
                                <circle cy="-10" r="22" fill="#0f172a" />
                            </g>
                            <g transform="translate(400, 535)">
                                <path d="M-38 50 Q-38 2 0 2 Q38 2 38 50 Z" fill="#0f172a" />
                                <circle cy="-8" r="21" fill="#0f172a" />
                            </g>
                            <g transform="translate(650, 530)">
                                <path d="M-42 50 Q-42 0 0 0 Q42 0 42 50 Z" fill="#0f172a" />
                                <circle cy="-12" r="23" fill="#0f172a" />
                            </g>
                            <g transform="translate(850, 520)">
                                <path d="M-40 50 Q-40 0 0 0 Q40 0 40 50 Z" fill="#0f172a" />
                                <circle cy="-10" r="22" fill="#0f172a" />
                            </g>
                        </g>
                    </svg>
                </div>

                <!-- SCENE 5: DEBRIEF -->
                <div id="scene5" class="scene">
                    <svg viewBox="0 0 1000 562.5" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                        <rect width="1000" height="562.5" fill="#020617" />
                        <rect x="80" y="40" width="840" height="480" rx="8" fill="#0f172a" stroke="#1e293b" stroke-width="2" />
                        
                        <g transform="translate(120, 85)">
                            <text x="0" y="25" fill="white" font-size="24" font-weight="800">MISSION ANALYSIS</text>
                            <text x="0" y="48" fill="#64748b" font-size="14">Flight Performance Summary</text>
                            
                            <g transform="translate(0, 75)">
                                <text x="0" y="15" fill="#ef4444" font-size="10" font-weight="800" letter-spacing="1">PENALTIES</text>
                                <g transform="translate(0, 32)">
                                    <text x="0" y="0" fill="white" font-size="12" font-weight="600">• Corridor Excursion</text>
                                    <text x="220" y="0" fill="#ef4444" font-size="12" font-weight="800" text-anchor="end">-120</text>
                                    <text x="0" y="25" fill="white" font-size="12" font-weight="600">• Timing Error (Gate 2)</text>
                                    <text x="220" y="25" fill="#ef4444" font-size="12" font-weight="800" text-anchor="end">-15</text>
                                </g>
                            </g>

                            <g transform="translate(0, 160)">
                                <rect width="220" height="110" rx="4" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.05)" />
                                <text x="20" y="30" fill="#3b82f6" font-size="10" font-weight="800">FINAL SCORE</text>
                                <text x="20" y="75" fill="white" font-size="42" font-weight="800">2,482</text>
                            </g>
                            
                            <g transform="translate(260, 75)">
                                <rect width="460" height="225" rx="4" fill="#020617" stroke="#1e293b" />
                                <text x="20" y="25" fill="#64748b" font-size="10">POSITION DEVIATION</text>
                                <path d="M20 180 L100 170 L200 175 L300 40 L440 170" stroke="#3b82f6" stroke-width="3" fill="none" />
                                <circle cx="300" cy="40" r="6" fill="#ef4444" />
                                <text x="300" y="65" fill="#ef4444" font-size="11" font-weight="800" text-anchor="middle">CLIP DETECTED</text>
                            </g>
                            
                            <g id="final-actions" opacity="0" transform="translate(0, 330)">
                                <rect width="720" height="75" fill="rgba(59,130,246,0.05)" rx="4" />
                                <text x="30" y="42" fill="white" font-size="20" font-weight="800">Ready for the next second?</text>
                                <g id="replay-btn" transform="translate(520, 18)" cursor="pointer">
                                    <rect width="170" height="40" rx="20" fill="#3b82f6" />
                                    <text x="85" y="25" fill="white" font-size="14" font-weight="800" text-anchor="middle">REPLAY MISSION</text>
                                </g>
                            </g>
                        </g>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #animation-container {
        font-family: 'Inter', sans-serif;
        color: white;
    }

    .scene {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
    }

    .active-scene {
        opacity: 1;
        visibility: visible;
    }

    .ui-overlay {
        position: absolute;
        top: 24px;
        left: 24px;
        z-index: 50;
        display: flex;
        gap: 12px;
    }

    .aslt-badge {
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(59, 130, 246, 0.3);
        padding: 4px 12px;
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: white;
    }

    .timestamp {
        position: absolute;
        bottom: 24px;
        right: 24px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 16px;
        color: #3b82f6;
        z-index: 50;
    }

    .glow-line { filter: drop-shadow(0 0 8px #3b82f6); }
    .glow-red { filter: drop-shadow(0 0 10px #ef4444); }

    #scene1 {
        perspective: 1500px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #1a110d;
    }

    .table-surface {
        position: absolute;
        width: 150%;
        height: 150%;
        background: #2d1e18;
        background-image: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.05) 0%, transparent 80%),
                          url("data:image/svg+xml,%3Csvg width='400' height='400' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 50 Q100 45 200 50 T400 50' stroke='%231a110d' fill='none' stroke-width='2'/%3E%3Cpath d='M0 150 Q150 155 300 150 T400 150' stroke='%231a110d' fill='none' stroke-width='2'/%3E%3C/svg%3E");
        transform: rotateX(60deg) translateY(-200px);
        box-shadow: inset 0 0 100px #000;
    }

    #flight-order-container {
        position: relative;
        width: 350px;
        height: 450px;
        background: white;
        box-shadow: 0 30px 60px rgba(0,0,0,0.8), 0 5px 15px rgba(0,0,0,0.4);
        transform: rotateX(45deg) rotateZ(-5deg) translateY(50px);
        transform-style: preserve-3d;
        padding: 20px;
    }

    .scanline-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.05) 50%);
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 60;
        opacity: 0.2;
    }
</style>

<script>
    import { gsap } from 'gsap';

    document.addEventListener('DOMContentLoaded', () => {
        const wrapper = document.getElementById('mission-animation-wrapper');
        const scenes = document.querySelectorAll('.scene');
        const timerEl = document.getElementById('timer');
        const aircraft = document.getElementById('aircraft');
        const flightTrail = document.getElementById('flight-trail');
        const devHud = document.getElementById('hud-dev');
        const penaltyCallout = document.getElementById('penalty-callout');
        const replayBtn = document.getElementById('replay-btn');
        
        let trailD = "";
        gsap.set(aircraft, { transformOrigin: "center center" });

        const tl = gsap.timeline({ paused: true });

        function switchScene(index) {
            scenes.forEach((s, i) => {
                s.classList.toggle('active-scene', i === index);
                // Ensure opacity is reset for GSAP if it was manipulated
                if (i === index) gsap.set(s, { opacity: 1, visibility: 'visible' });
                else gsap.set(s, { opacity: 0, visibility: 'hidden' });
            });
        }

        function resetState() {
            trailD = "";
            if (flightTrail) {
                flightTrail.setAttribute("d", "");
                flightTrail.setAttribute("stroke", "#3b82f6");
                flightTrail.classList.remove("glow-red");
            }
            if (devHud) {
                devHud.innerText = "0.0m";
                (devHud as HTMLElement).style.fill = "#ffffff";
            }
            gsap.set(penaltyCallout, { opacity: 0 });
            gsap.set(aircraft, { x: 100, y: 450, rotation: 0 });
            switchScene(0);
        }

        gsap.set(aircraft, { x: 100, y: 450 });

        tl.to({}, {
            duration: 25,
            onUpdate: function() {
                const time = tl.time().toFixed(2);
                const secs = Math.floor(parseFloat(time));
                const ms = Math.floor((parseFloat(time) - secs) * 100);
                if (timerEl) timerEl.innerText = `00:00:${secs.toString().padStart(2, '0')}:${ms.toString().padStart(2, '0')}`;
            }
        });

        // S1: Briefing
        tl.addLabel("briefing", 0);
        tl.from("#flight-order-container", { rotateX: 90, y: 300, opacity: 0, duration: 1.5, ease: "power3.out" }, "briefing");
        tl.from("#briefing-path", { strokeDasharray: 500, strokeDashoffset: 500, duration: 1.5 }, "briefing+=1");

        // S2: Activation
        tl.addLabel("activation", 4);
        tl.to({}, { duration: 0, onComplete: () => switchScene(1) }, "activation");
        tl.from("#pilot-arm", { y: 400, x: 100, duration: 1, ease: "power2.out" }, "activation");
        tl.from("#flight-yoke", { y: 200, opacity: 0, duration: 1, ease: "power2.out" }, "activation");
        tl.to("#go-button", { fill: "#10b981", scale: 1.05, duration: 0.2, repeat: 1, yoyo: true }, "activation+=2");
        tl.to("#efis-horizon", { y: -10, duration: 1.5, repeat: -1, yoyo: true }, "activation+=4");
        tl.to("#flight-yoke", { rotate: 5, duration: 3, repeat: -1, yoyo: true, ease: "sine.inOut" }, "activation+=4");

        // S3: Tactical Flight
        tl.addLabel("flight", 9);
        tl.to({}, { duration: 0, onComplete: () => {
            switchScene(2);
            gsap.set(aircraft, { x: 100, y: 450 });
            trailD = "M 100 450";
        }}, "flight");
        
        const flightPath = [{x: 100, y: 450}, {x: 300, y: 300}, {x: 500, y: 350}, {x: 550, y: 200}, {x: 700, y: 150}, {x: 900, y: 100}];
        
        flightPath.forEach((p, i) => {
            if (i === 0) return;
            const prev = flightPath[i-1];
            const angle = Math.atan2(p.y - prev.y, p.x - prev.x) * (180 / Math.PI) + 90;
            const duration = 8 / (flightPath.length - 1);
            const startTime = `flight+=${(i-1)*duration}`;

            tl.set(aircraft, { rotation: angle }, startTime);
            tl.to(aircraft, {
                x: p.x, y: p.y, duration: duration, ease: "none",
                onUpdate: function() {
                    const x = gsap.getProperty(aircraft, "x") as number;
                    const y = gsap.getProperty(aircraft, "y") as number;
                    if (trailD === "") trailD = `M ${x} ${y}`;
                    else trailD += ` L ${x} ${y}`;
                    if (flightTrail) flightTrail.setAttribute("d", trailD);
                    const currentTime = tl.time();
                    if (currentTime > 12.2 && currentTime < 14.2) {
                        if (flightTrail) {
                            flightTrail.setAttribute("stroke", "#ef4444");
                            flightTrail.classList.add("glow-red");
                        }
                        if (devHud) {
                            devHud.innerText = "58.4m";
                            (devHud as HTMLElement).style.fill = "#ef4444";
                        }
                        gsap.set(penaltyCallout, { opacity: 1, x: x, y: y });
                    } else {
                        if (flightTrail) {
                            flightTrail.setAttribute("stroke", "#3b82f6");
                            flightTrail.classList.remove("glow-red");
                        }
                        if (devHud) {
                            devHud.innerText = "0.2m";
                            (devHud as HTMLElement).style.fill = "#ffffff";
                        }
                        gsap.set(penaltyCallout, { opacity: 0 });
                    }
                }
            }, startTime);
        });

        // S4: Clubhouse
        tl.addLabel("clubhouse", 17);
        tl.to({}, { duration: 0, onComplete: () => switchScene(3) }, "clubhouse");
        tl.to("#spectator-crowd g", { y: "-=30", duration: 0.6, repeat: 10, yoyo: true, stagger: 0.1, ease: "sine.inOut" }, "clubhouse");

        // S5: Debrief
        tl.addLabel("debrief", 22);
        tl.to({}, { duration: 0, onComplete: () => switchScene(4) }, "debrief");
        tl.to("#final-actions", { opacity: 1, duration: 0.5 }, "debrief+=1.5");

        if (replayBtn) {
            replayBtn.addEventListener('click', () => {
                resetState();
                tl.restart();
            });
        }

        // Intersection Observer for Autoplay
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    tl.play();
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.6 });

        if (wrapper) observer.observe(wrapper);
    });
</script>
