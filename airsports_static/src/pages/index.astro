---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import nordic2025 from '../assets/img/nordic2025.png';
import dashboard from '../assets/img/dashboard.png';
import routeEditor from '../assets/img/route_editor.png';
import task from '../assets/img/task.png';
import logoNoTextWhite from '../assets/img/airsports_no_text_white.png';
import TodaysFlights from '../components/TodaysFlights.astro';

// Competition Graphics
import precisionImg from '../assets/img/Precision.png';
import anrImg from '../assets/img/ANR.png';
import challengeImg from '../assets/img/AirSportsChallenge.png';
import msfsClientImg from '../assets/img/msfs_client.png';
---

<Layout title="Home">
	<main>
        <!-- Hero Section -->
        <div class="relative overflow-hidden bg-slate-900 text-white pt-20 pb-32">
            <!-- Background Image with Opacity -->
            <div class="absolute inset-0 z-0">
                <Image src={nordic2025} alt="" class="w-full h-full object-cover opacity-40 mix-blend-luminosity" width={1920} height={1080} />
                <div class="absolute inset-0 bg-gradient-to-b from-[#2563EB]/80 via-[#2563EB]/40 to-slate-900/90"></div>
            </div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                <div class="inline-block px-4 py-1.5 mb-8 text-[10px] sm:text-xs font-bold tracking-[0.2em] uppercase bg-white/10 backdrop-blur-md rounded-full border border-white/20 text-blue-100">
                    Open Source & Global Community
                </div>
                <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tighter mb-8 font-lexend italic text-shadow-lg uppercase leading-tight">
                    The sky is your <br/>
                    <span class="text-blue-200">playground</span>
                </h1>

                <!-- Migration Notice -->
                <div class="mb-14 inline-block animate-in fade-in slide-in-from-bottom-4 duration-1000 delay-300 max-w-4xl w-full mx-auto px-4">
                    <a href="https://app.airsports.no" class="group flex flex-row items-center justify-center gap-4 sm:gap-8 bg-orange-600/90 backdrop-blur-md border-2 border-orange-400 py-3 px-6 sm:py-4 sm:px-10 rounded-full shadow-2xl hover:bg-orange-600 transition-all hover:scale-[1.01] active:scale-95 text-white">
                        <div class="bg-white/20 p-2 rounded-full hidden sm:block flex-shrink-0">
                             <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                             </svg>
                        </div>
                        <div class="text-left flex items-center gap-4">
                            <span class="hidden lg:block text-[10px] font-black uppercase tracking-[0.3em] text-orange-200 border-r border-orange-400/50 pr-4">Platform Update</span>
                            <span class="text-sm sm:text-lg lg:text-xl font-extrabold font-lexend italic uppercase tracking-tight">
                                Competition Dashboard has moved to 
                                <span class="text-blue-100 underline decoration-white decoration-2 underline-offset-4 ml-1">app.airsports.no</span>
                            </span>
                        </div>
                        <div class="group-hover:translate-x-2 transition-transform hidden sm:block flex-shrink-0">
                             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                             </svg>
                        </div>
                    </a>
                </div>

                <p class="text-lg sm:text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-14 leading-relaxed font-medium">
                    The professional platform for precision navigation and air racing. 
                    <span class="text-white">Whether you're flying 120km cross-country or competing virtually, we score your performance in real time.</span>
                </p>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://app.airsports.no/competition-map/774/2734?mode=playback&time=2025-07-06T11:45:50&speed=40&autoplay=true&rankingExpanded=true" class="bg-orange-500 text-white px-12 py-5 rounded-2xl font-extrabold text-lg hover:bg-orange-600 transition-all shadow-2xl shadow-orange-900/40 active:scale-95 uppercase tracking-wider border-b-4 border-orange-700">
                        Watch a Competition Replay →
                    </a>
                    <a href="https://app.airsports.no" class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-12 py-5 rounded-2xl font-extrabold text-lg hover:bg-white/20 transition-all active:scale-95 uppercase tracking-wider">
                        Competition Dashboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Credibility Bar -->
        <div class="bg-slate-900 border-y border-white/5 py-8 relative z-30">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-wrap justify-center md:justify-between items-center gap-8 opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl font-black text-white font-lexend italic uppercase tracking-tighter">10.8M+</span>
                        <span class="text-[10px] font-bold text-blue-200 uppercase tracking-[0.2em] leading-tight">GPS Points <br/> Processed</span>
                    </div>
                    <div class="w-px h-8 bg-white/10 hidden md:block"></div>
                    <div class="flex items-center gap-3">
                        <span class="text-2xl font-black text-white font-lexend italic uppercase tracking-tighter">22</span>
                        <span class="text-[10px] font-bold text-blue-200 uppercase tracking-[0.2em] leading-tight">Countries <br/> Represented</span>
                    </div>
                    <div class="w-px h-8 bg-white/10 hidden md:block"></div>
                    <div class="flex items-center gap-3">
                        <span class="text-2xl font-black text-white font-lexend italic uppercase tracking-tighter">3,900+</span>
                        <span class="text-[10px] font-bold text-blue-200 uppercase tracking-[0.2em] leading-tight">Total <br/> Competitors</span>
                    </div>
                    <div class="w-px h-8 bg-white/10 hidden md:block"></div>
                    <div class="flex items-center gap-3 text-white/80 font-black text-xs uppercase tracking-widest italic">
                        Norway • Spain • Sweden • Denmark • Germany • Globally
                    </div>
                </div>
            </div>
        </div>

        <!-- Today's Flights Section (Experience it now) -->
        <div class="relative z-20">
            <TodaysFlights />
        </div>

        <!-- The Sports Section -->
        <div class="py-32 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-20">
                    <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 font-lexend italic mb-6 uppercase tracking-tight">The Sports</h2>
                    <p class="text-slate-600 text-xl max-w-2xl mx-auto font-medium">From professional world championships to weekend fly-ins, we provide the tools to compete.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Precision Flying -->
                    <div class="bg-white rounded-[2.5rem] overflow-hidden shadow-xl border border-slate-200 group hover:border-blue-500/50 transition-all">
                        <div class="h-48 overflow-hidden relative">
                            <Image src={precisionImg} alt="Precision Flying" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
                            <div class="absolute bottom-6 left-8">
                                <h4 class="text-white font-bold text-xl font-lexend italic uppercase">Precision Flying</h4>
                            </div>
                        </div>
                        <div class="p-8">
                            <p class="text-slate-600 text-sm leading-relaxed mb-6">
                                The "Formula 1" of navigation. Pilots fly solo, hitting hidden checkpoints down to the exact second using only a paper map and a stopwatch.
                            </p>
                            <ul class="space-y-3 mb-8">
                                <li class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-blue-600 italic">
                                    <span class="w-1.5 h-1.5 bg-blue-600 rounded-full"></span> 1-Second Timing Window
                                </li>
                                <li class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-blue-600 italic">
                                    <span class="w-1.5 h-1.5 bg-blue-600 rounded-full"></span> Ground Observation
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- ANR -->
                    <div class="bg-white rounded-[2.5rem] overflow-hidden shadow-xl border border-slate-200 group hover:border-orange-500/50 transition-all">
                        <div class="h-48 overflow-hidden relative">
                            <Image src={anrImg} alt="ANR" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
                            <div class="absolute bottom-6 left-8">
                                <h4 class="text-white font-bold text-xl font-lexend italic uppercase">Air Navigation Race</h4>
                            </div>
                        </div>
                        <div class="p-8">
                            <p class="text-slate-600 text-sm leading-relaxed mb-6">
                                Modern, fast, and visual. Two-person crews fight to stay inside a narrow corridor. Straying outside triggers immediate penalties.
                            </p>
                            <ul class="space-y-3 mb-8">
                                <li class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-orange-600 italic">
                                    <span class="w-1.5 h-1.5 bg-orange-600 rounded-full"></span> Corridor Discipline
                                </li>
                                <li class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-orange-600 italic">
                                    <span class="w-1.5 h-1.5 bg-orange-600 rounded-full"></span> Knock-out Brackets
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Air Sports Challenge -->
                    <div class="bg-white rounded-[2.5rem] overflow-hidden shadow-xl border border-slate-200 group hover:border-indigo-500/50 transition-all">
                        <div class="h-48 overflow-hidden relative">
                            <Image src={challengeImg} alt="Air Sports Challenge" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
                            <div class="absolute bottom-6 left-8">
                                <h4 class="text-white font-bold text-xl font-lexend italic uppercase">Air Sports Challenge</h4>
                            </div>
                        </div>
                        <div class="p-8">
                            <p class="text-slate-600 text-sm leading-relaxed mb-6">
                                The ultimate test. Combines Precision timing with the ANR corridor, adding dynamic prohibited zones and tactical obstacles.
                            </p>
                            <ul class="space-y-3 mb-8">
                                <li class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-indigo-600 italic">
                                    <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full"></span> Tactical Obstacles
                                </li>
                                <li class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-indigo-600 italic">
                                    <span class="w-1.5 h-1.5 bg-indigo-600 rounded-full"></span> Hybrid Scoring
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Role-Based CTA Grid -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-32">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 group hover:border-blue-200 transition-all flex flex-col h-full">
                    <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-3xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4 text-slate-900 font-lexend italic">FOR PILOTS</h3>
                    <p class="text-slate-500 leading-relaxed mb-6 text-sm">
                        Find upcoming contests, register your crew, and track your precision flights live.
                    </p>
                    
                    <!-- Expanded Pilot Resources -->
                    <div class="space-y-3 mb-8 flex-1">
                        <a href="/example_flight_order.pdf" target="_blank" class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl hover:bg-blue-50 transition-colors group/link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span class="text-xs font-bold text-slate-700 group-hover/link:text-blue-600 uppercase tracking-wider">Example Flight Order</span>
                        </a>
                        <a href="https://youtu.be/h4OblJAbxzo?si=rhHrYA_Ke_gKdn_6" target="_blank" class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl hover:bg-red-50 transition-colors group/link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="text-xs font-bold text-slate-700 group-hover/link:text-red-600 uppercase tracking-wider">App Tutorial Video</span>
                        </a>
                    </div>

                    <a href="https://app.airsports.no" class="text-blue-600 font-bold flex items-center gap-2 text-xs uppercase tracking-widest hover:underline mt-auto">
                        Competition Dashboard <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
                    </a>
                </div>
                
                <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 group hover:border-orange-200 transition-all flex flex-col h-full">
                    <div class="w-16 h-16 bg-orange-50 text-orange-600 rounded-3xl flex items-center justify-center mb-10 group-hover:bg-orange-600 group-hover:text-white transition-all shadow-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4 text-slate-900 font-lexend italic">FOR ORGANIZERS</h3>
                    <p class="text-slate-500 leading-relaxed mb-6 text-sm">
                        Create your own contest and design custom routes with our precision editor.
                    </p>

                    <!-- Expanded Organizer Resources -->
                    <div class="space-y-3 mb-8 flex-1">
                        <a href="/docs/03_Contest_Manager_Guide" class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl hover:bg-orange-50 transition-colors group/link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                            <span class="text-xs font-bold text-slate-700 group-hover/link:text-orange-600 uppercase tracking-wider">Contest Manager Guide</span>
                        </a>
                    </div>

                    <a href="https://app.airsports.no/upgrade-organizer" class="text-orange-600 font-bold flex items-center gap-2 text-xs uppercase tracking-widest hover:underline mt-auto">
                        Become Organizer <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
                    </a>
                </div>

                <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 group hover:border-indigo-200 transition-all flex flex-col h-full">
                    <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-3xl flex items-center justify-center mb-10 group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4 text-slate-900 font-lexend italic">FOR SPECTATORS</h3>
                    <p class="text-slate-500 leading-relaxed mb-6 text-sm">
                        Experience a real competition with our interactive playback and scoring.
                    </p>

                    <!-- Expanded Spectator Resources -->
                    <div class="space-y-3 mb-8 flex-1">
                        <a href="https://youtu.be/jywBZyqcL1Q?si=XtSSLYmgj3c0Mx6r" target="_blank" class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl hover:bg-red-50 transition-colors group/link">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="text-xs font-bold text-slate-700 group-hover/link:text-red-600 uppercase tracking-wider">Televised Competition Promo</span>
                        </a>
                    </div>

                    <a href="https://app.airsports.no/competition-map/774/2734?mode=playback&time=2025-07-06T11:45:50&speed=40&autoplay=true&rankingExpanded=true" class="text-indigo-600 font-bold flex items-center gap-2 text-xs uppercase tracking-widest hover:underline mt-auto">
                        Watch Action <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Platform in Action -->
        <div id="platform-in-action" class="py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white rounded-[4rem] shadow-sm mb-32">
            <div class="text-center mb-20">
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 font-lexend italic mb-6 uppercase tracking-tight">The Platform in Action</h2>
                <div class="w-24 h-1 bg-blue-600 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-32 px-8">
                <div class="order-2 lg:order-1">
                    <h3 class="text-3xl font-bold mb-6 font-lexend italic text-slate-800 uppercase">Operational Dashboard</h3>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed font-medium">
                        Manage your entire event from a single unified dashboard. Track contestants in real-time, monitor system health, and oversee the automated scoring process as it unfolds.
                    </p>
                    <ul class="space-y-4 font-bold text-slate-700 uppercase tracking-tight text-sm italic">
                        <li class="flex items-start gap-4">
                            <span class="text-blue-600">01</span>
                            <span>Real-time position monitoring for all active aircraft.</span>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-blue-600">02</span>
                            <span>Instant task assignment and team registration.</span>
                        </li>
                    </ul>
                </div>
                <div class="order-1 lg:order-2 bg-slate-100 p-4 rounded-[3rem] shadow-3xl transform rotate-1 hover:rotate-0 transition-all duration-500 overflow-hidden border border-slate-200 hover:scale-[1.03] cursor-zoom-in group/img">
                    <Image src={dashboard} alt="ASLT Dashboard" class="rounded-[2rem] shadow-inner w-full h-auto lightbox-trigger" width={1000} height={600} data-full-src={dashboard.src} />
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center px-8 mb-32">
                <div class="bg-slate-100 p-4 rounded-[3rem] shadow-3xl transform -rotate-1 hover:rotate-0 transition-all duration-500 overflow-hidden border border-slate-200 hover:scale-[1.03] cursor-zoom-in group/img">
                    <Image src={routeEditor} alt="ASLT Route Editor" class="rounded-[2rem] shadow-inner w-full h-auto lightbox-trigger" width={1000} height={600} data-full-src={routeEditor.src} />
                </div>
                <div>
                    <h3 class="text-3xl font-bold mb-6 font-lexend italic text-slate-800 uppercase">Intelligent Route Editor</h3>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed font-medium">
                        Design complex navigation tasks with ease. Our integrated editor supports AIP chart overlays, custom georeferenced maps, and GDL90 telemetry.
                    </p>
                    <ul class="space-y-4 font-bold text-slate-700 uppercase tracking-tight text-sm italic">
                        <li class="flex items-start gap-4">
                            <span class="text-orange-600">01</span>
                            <span>Support for <strong>Garmin GDL90</strong> and OGN telemetry protocols.</span>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-orange-600">02</span>
                            <span>Automatically generate high-resolution PDF Flight Orders for pilots.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center px-8">
                <div class="order-2 lg:order-1">
                    <h3 class="text-3xl font-bold mb-6 font-lexend italic text-slate-800 uppercase">Live Competition Map</h3>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed font-medium">
                        Experience the thrill of the race as it happens. Our live map provides spectators with a real-time view of every contestant and instant penalty notifications.
                    </p>
