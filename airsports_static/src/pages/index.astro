---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import nordic2025 from '../assets/img/nordic2025.png';
import dashboard from '../assets/img/dashboard.png';
import routeEditor from '../assets/img/route_editor.png';
import task from '../assets/img/task.png';
import logoNoTextWhite from '../assets/img/airsports_no_text_white.png';
import TodaysFlights from '../components/TodaysFlights.astro';
---

<Layout title="Home">
	<main>
        <!-- Hero Section -->
        <div class="relative overflow-hidden bg-slate-900 text-white pt-20 pb-32">
            <!-- Background Image with Opacity -->
            <div class="absolute inset-0 z-0">
                <Image src={nordic2025} alt="" class="w-full h-full object-cover opacity-40 mix-blend-luminosity" width={1920} height={1080} />
                <div class="absolute inset-0 bg-gradient-to-b from-[#2563EB]/80 via-[#2563EB]/40 to-slate-900/90"></div>
            </div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                <div class="inline-block px-4 py-1.5 mb-8 text-[10px] sm:text-xs font-bold tracking-[0.2em] uppercase bg-white/10 backdrop-blur-md rounded-full border border-white/20 text-blue-100">
                    Open Source & Community Driven
                </div>
                <h1 class="text-4xl sm:text-6xl md:text-8xl font-extrabold tracking-tighter mb-8 font-lexend italic text-shadow-lg uppercase leading-tight">
                    The sky is your <br/>
                    <span class="text-blue-200">playground</span>
                </h1>
                <p class="text-lg sm:text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-14 leading-relaxed font-medium">
                    Air Sports Live Tracking (ASLT) is an online scoring platform providing 
                    <span class="text-white border-b-2 border-orange-400 pb-1">real-time visualization</span> and <span class="text-white border-b-2 border-orange-400 pb-1">automated scoring</span> for competitive flying.
                </p>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://airsports.no" class="bg-white text-blue-600 px-12 py-5 rounded-2xl font-extrabold text-lg hover:bg-blue-50 transition-all shadow-2xl shadow-blue-900/40 active:scale-95 uppercase tracking-wider">
                        Airsports Dashboard
                    </a>
                    <a href="/docs/01_Introduction" class="bg-blue-500/40 backdrop-blur-md border border-blue-400/40 text-white px-12 py-5 rounded-2xl font-extrabold text-lg hover:bg-blue-500/60 transition-all active:scale-95 uppercase tracking-wider">
                        Documentation
                    </a>
                </div>
            </div>
        </div>

        <!-- Role-Based Navigation -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24 relative z-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <a href="/docs/02_Contestant_Guide" class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 group hover:border-blue-200 transition-all">
                    <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-3xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4 text-slate-900 font-lexend italic">FOR PILOTS</h3>
                    <p class="text-slate-500 leading-relaxed mb-8 text-sm">
                        Register for events, manage your team, and track your flights using only your smartphone.
                    </p>
                    <span class="text-blue-600 font-bold flex items-center gap-2 text-xs uppercase tracking-widest">
                        Get Started <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
                    </span>
                </a>
                
                <a href="/docs/03_Contest_Manager_Guide" class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 group hover:border-orange-200 transition-all">
                    <div class="w-16 h-16 bg-orange-50 text-orange-600 rounded-3xl flex items-center justify-center mb-10 group-hover:bg-orange-600 group-hover:text-white transition-all shadow-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4 text-slate-900 font-lexend italic">FOR ORGANIZERS</h3>
                    <p class="text-slate-500 leading-relaxed mb-8 text-sm">
                        Establish contests, design routes, and manage logistics with our linear programming optimizer.
                    </p>
                    <span class="text-orange-600 font-bold flex items-center gap-2 text-xs uppercase tracking-widest">
                        Manage Events <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
                    </span>
                </a>

                <a href="/docs/05_Results_Service_Guide" class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 group hover:border-indigo-200 transition-all">
                    <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-3xl flex items-center justify-center mb-10 group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4 text-slate-900 font-lexend italic">FOR SPECTATORS</h3>
                    <p class="text-slate-500 leading-relaxed mb-8 text-sm">
                        Follow live clubhouse leaderboards and track every turn with synchronized WebSocket updates.
                    </p>
                    <span class="text-indigo-600 font-bold flex items-center gap-2 text-xs uppercase tracking-widest">
                        View Results <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" /></svg>
                    </span>
                </a>
            </div>
        </div>

        <!-- Today's Flights Section -->
        <TodaysFlights />

        <!-- Platform in Action -->
        <div id="platform-in-action" class="py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-20">
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 font-lexend italic mb-6 uppercase tracking-tight">The Platform in Action</h2>
                <div class="w-24 h-1 bg-blue-600 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-32">
                <div class="order-2 lg:order-1">
                    <h3 class="text-3xl font-bold mb-6 font-lexend italic text-slate-800 uppercase">Operational Dashboard</h3>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed font-medium">
                        Manage your entire event from a single unified dashboard. Track contestants in real-time, monitor system health, and oversee the automated scoring process as it unfolds.
                    </p>
                    <ul class="space-y-4 font-bold text-slate-700 uppercase tracking-tight text-sm italic">
                        <li class="flex items-start gap-4">
                            <span class="text-blue-600">01</span>
                            <span>Real-time position monitoring for all active aircraft.</span>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-blue-600">02</span>
                            <span>Instant task assignment and team registration.</span>
                        </li>
                    </ul>
                </div>
                <div class="order-1 lg:order-2 bg-slate-100 p-4 rounded-[3rem] shadow-3xl transform rotate-1 hover:rotate-0 transition-all duration-500 overflow-hidden border border-slate-200 hover:scale-[1.03] cursor-zoom-in group/img">
                    <Image src={dashboard} alt="ASLT Dashboard" class="rounded-[2rem] shadow-inner w-full h-auto lightbox-trigger" width={1000} height={600} data-full-src={dashboard.src} />
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="bg-slate-100 p-4 rounded-[3rem] shadow-3xl transform -rotate-1 hover:rotate-0 transition-all duration-500 overflow-hidden border border-slate-200 hover:scale-[1.03] cursor-zoom-in group/img">
                    <Image src={routeEditor} alt="ASLT Route Editor" class="rounded-[2rem] shadow-inner w-full h-auto lightbox-trigger" width={1000} height={600} data-full-src={routeEditor.src} />
                </div>
                <div>
                    <h3 class="text-3xl font-bold mb-6 font-lexend italic text-slate-800 uppercase">Intelligent Route Editor</h3>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed font-medium">
                        Design complex navigation tasks with ease. Our integrated editor supports AIP chart overlays, custom georeferenced maps, secret gates, and precision-timed waypoints.
                    </p>
                    <ul class="space-y-4 font-bold text-slate-700 uppercase tracking-tight text-sm italic">
                        <li class="flex items-start gap-4">
                            <span class="text-orange-600">01</span>
                            <span>Draw corridors and prohibited zones directly on aeronautical charts.</span>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-orange-600">02</span>
                            <span>Automatically generate high-resolution PDF Flight Orders for pilots.</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-32">
                <div class="order-2 lg:order-1">
                    <h3 class="text-3xl font-bold mb-6 font-lexend italic text-slate-800 uppercase">Live Competition Map</h3>
                    <p class="text-lg text-slate-600 mb-8 leading-relaxed font-medium">
                        Experience the thrill of the race as it happens. Our live competition map provides spectators and organizers with a real-time view of every contestant, complete with trail breadcrumbs and instant penalty notifications.
                    </p>
                    <ul class="space-y-4 font-bold text-slate-700 uppercase tracking-tight text-sm italic">
                        <li class="flex items-start gap-4">
                            <span class="text-indigo-600">01</span>
                            <span>High-fidelity tracking with low-latency WebSocket updates.</span>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-indigo-600">02</span>
                            <span>Visual confirmation of gate crossings and corridor compliance.</span>
                        </li>
                    </ul>
                </div>
                <div class="order-1 lg:order-2 bg-slate-100 p-4 rounded-[3rem] shadow-3xl transform rotate-1 hover:rotate-0 transition-all duration-500 overflow-hidden border border-slate-200 hover:scale-[1.03] cursor-zoom-in group/img">
                    <Image src={task} alt="ASLT Live Competition Map" class="rounded-[2rem] shadow-inner w-full h-auto lightbox-trigger" width={1000} height={600} data-full-src={task.src} />
                </div>
            </div>
        </div>

        <!-- Vision Section -->
        <div class="py-32 bg-white relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                    <div>
                        <h2 class="text-4xl font-extrabold mb-8 tracking-tight text-slate-900 font-lexend italic uppercase">Professional Grade. <br/> <span class="text-blue-600">Open Source Heart.</span></h2>
                        <p class="text-lg text-slate-600 mb-10 leading-relaxed font-medium">
                            ASLT was born from a desire to make air sports more transparent and interactive. Traditional scoring often relies on manual logs and post-flight processing. We changed that.
                        </p>
                        
                        <div class="space-y-10">
                            <div class="flex gap-8">
                                <div class="w-14 h-14 rounded-2xl bg-blue-50 flex-shrink-0 flex items-center justify-center text-blue-600 font-extrabold text-xl font-lexend shadow-sm border border-blue-100">1</div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-xl mb-2 font-lexend uppercase italic tracking-tight text-shadow-sm">Real-time Scoring</h4>
                                    <p class="text-slate-500 text-sm leading-relaxed tracking-wide font-medium">Penalties are calculated as they happen, allowing for live leaderboards in the clubhouse.</p>
                                </div>
                            </div>
                            <div class="flex gap-8">
                                <div class="w-14 h-14 rounded-2xl bg-blue-50 flex-shrink-0 flex items-center justify-center text-blue-600 font-extrabold text-xl font-lexend shadow-sm border border-blue-100">2</div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-xl mb-2 font-lexend uppercase italic tracking-tight text-shadow-sm">Adaptive Start Logic</h4>
                                    <p class="text-slate-500 text-sm leading-relaxed tracking-wide font-medium">Handles the realities of aviation (wind, signal gaps, pre-flight delays) to keep scoring fair.</p>
                                </div>
                            </div>
                            <div class="flex gap-8">
                                <div class="w-14 h-14 rounded-2xl bg-blue-50 flex-shrink-0 flex items-center justify-center text-blue-600 font-extrabold text-xl font-lexend shadow-sm border border-blue-100">3</div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-xl mb-2 font-lexend uppercase italic tracking-tight text-shadow-sm">Cost Efficient</h4>
                                    <p class="text-slate-500 text-sm leading-relaxed tracking-wide font-medium">Eliminates the need for specialized hardware by using ubiquitous iOS/Android devices.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="relative">
                        <div class="bg-gradient-to-tr from-blue-600 to-indigo-800 rounded-[4rem] aspect-square shadow-3xl transform rotate-2 relative overflow-hidden border-8 border-white">
                            <div class="absolute inset-0 flex items-center justify-center opacity-10 transform -rotate-2 scale-150">
                                <Image src={logoNoTextWhite} alt="Watermark" class="w-full h-auto" width={600} height={600} />
                            </div>
                            <div class="absolute inset-12 flex flex-col justify-end text-white transform -rotate-2">
                                <p class="text-4xl font-extrabold leading-tight mb-6 font-lexend italic uppercase tracking-tighter">Supporting MSFS 2020 & 2024</p>
                                <p class="text-blue-100 text-lg font-medium">Compete in virtual tasks using our dedicated high-fidelity simulator client.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Video Tutorials CTA -->
        <div class="py-24 bg-indigo-900 text-white relative overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path d="M0 100 L100 0 L100 100 Z" fill="currentColor" />
                </svg>
            </div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                <h2 class="text-4xl font-extrabold mb-6 font-lexend italic uppercase tracking-tight">New to the platform?</h2>
                <p class="text-xl text-indigo-100 mb-10 max-w-2xl mx-auto font-medium">
                    Watch our step-by-step video tutorials to get started with competition management and registration.
                </p>
                <a href="/tutorials" class="inline-flex items-center gap-3 bg-white text-indigo-900 px-10 py-4 rounded-2xl font-extrabold hover:bg-indigo-50 transition-all shadow-xl active:scale-95 uppercase tracking-wider">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                    </svg>
                    Watch Video Tutorials
                </a>
            </div>
        </div>

        <!-- Funding Section -->
        <div class="bg-slate-50 border-y border-slate-200 py-32 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-96 h-96 bg-blue-100 rounded-full mix-blend-multiply opacity-20 filter blur-3xl -mr-48 -mt-48"></div>
            <div class="max-w-7xl mx-auto px-4 relative z-10">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-8 font-lexend italic uppercase tracking-tight">Support & Funding</h2>
                    <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed font-medium mb-12">
                        Our primary server is up and running at <a href="https://airsports.no" class="text-blue-600 font-bold underline decoration-blue-600/30">airsports.no</a> free of charge. 
                        We rely on community contributions to maintain high-performance capacity.
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                    <!-- Bank Details Card -->
                    <div class="bg-white p-12 rounded-[3rem] shadow-3xl border border-slate-200">
                        <h4 class="font-bold text-xs mb-8 flex items-center gap-3 text-slate-400 uppercase tracking-[0.3em] font-lexend italic">
                            <span class="w-3 h-3 bg-orange-500 rounded-full shadow-[0_0_8px_rgba(249,115,22,0.4)]"></span>
                            Payment Information
                        </h4>
                        <div class="space-y-6 text-slate-700 font-bold font-mono text-sm tracking-tighter">
                            <div class="flex justify-between border-b border-slate-50 pb-4">
                                <span class="text-slate-400 font-lexend uppercase italic text-[10px] tracking-widest">IBAN</span>
                                <span>NO84 1506 4113 078</span>
                            </div>
                            <div class="flex justify-between border-b border-slate-50 pb-4">
                                <span class="text-slate-400 font-lexend uppercase italic text-[10px] tracking-widest">BIC</span>
                                <span>DNBANOKKXXX</span>
                            </div>
                            <div class="flex flex-col gap-2">
                                <span class="text-slate-400 font-lexend uppercase italic text-[10px] tracking-widest">BANK</span>
                                <span class="text-right uppercase">DNB BANK ASA, TONSBERG</span>
                            </div>
                        </div>
                        <div class="mt-10 p-6 bg-orange-50 rounded-2xl border border-orange-100">
                            <p class="text-[10px] uppercase font-bold tracking-widest text-orange-700 mb-2 italic">Important</p>
                            <p class="text-xs text-orange-800 leading-relaxed font-medium italic italic">
                                "Please write who the donor is and whether you would like to remain anonymous. All donations will be published on this page."
                            </p>
                        </div>
                    </div>

                    <!-- Donor List Card -->
                    <div class="bg-[#0F172A] p-12 rounded-[3rem] shadow-3xl text-white">
                        <h4 class="font-bold text-xs mb-8 flex items-center gap-3 text-blue-400 uppercase tracking-[0.3em] font-lexend italic">
                            <span class="w-3 h-3 bg-blue-500 rounded-full shadow-[0_0_8px_rgba(59,130,246,0.5)]"></span>
                            Donations & Sponsors
                        </h4>
                        <div class="space-y-8">
                            <div>
                                <h5 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">Competition Year 2024</h5>
                                <ul class="space-y-3">
                                    <li class="flex justify-between items-center text-sm border-b border-white/5 pb-2">
                                        <span class="font-medium">Norwegian Air Sports Federation</span>
                                        <span class="text-blue-400 font-bold font-mono">€1703,-</span>
                                    </li>
                                    <li class="flex justify-between items-start text-sm border-b border-white/5 pb-2 gap-4 text-right">
                                        <span class="font-medium text-left">Spain REAL FEDERACION AERONAUTICA <span class="block text-[10px] text-slate-500 font-medium lowercase italic italic tracking-normal">(3 yr commitment)</span></span>
                                        <span class="text-blue-400 font-bold font-mono">€1000,-</span>
                                    </li>
                                    <li class="flex justify-between items-center text-sm border-b border-white/5 pb-2">
                                        <span class="font-medium">KSAK Swedish Air Sports Federation</span>
                                        <span class="text-blue-400 font-bold font-mono">€926,-</span>
                                    </li>
                                    <li class="flex justify-between items-center text-sm border-b border-white/5 pb-2">
                                        <span class="font-medium">Airsports Denmark</span>
                                        <span class="text-blue-400 font-bold font-mono">€426,-</span>
                                    </li>
                                    <li class="flex justify-between items-center text-sm border-b border-white/5 pb-2">
                                        <span class="font-medium">Deutscher Aero Club E.V. Eu</span>
                                        <span class="text-blue-400 font-bold font-mono">€1000,-</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h5 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">Sponsors 2023</h5>
                                <ul class="space-y-3">
                                    <li class="flex justify-between items-center text-sm border-b border-white/5 pb-2 italic">
                                        <span class="font-medium">Spain REAL FEDERACION AERONAUTICA</span>
                                        <span class="text-orange-400 font-bold font-mono">€580,-</span>
                                    </li>
                                    <li class="flex justify-between items-center text-sm border-b border-white/5 pb-2 italic">
                                        <span class="font-medium">Norwegian Air Sports Federation</span>
                                        <span class="text-orange-400 font-bold font-mono">€3851,-</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lightbox Modal -->
        <div id="lightbox" class="fixed inset-0 z-[100] bg-slate-950/90 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center p-4 md:p-12">
            <button id="close-lightbox" class="absolute top-8 right-8 text-white/50 hover:text-white transition-colors p-2 z-[110]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <div class="relative w-full h-full flex items-center justify-center lightbox-content">
                <img id="lightbox-img" src="" alt="Enlarged view" class="max-w-full max-h-full object-contain rounded-2xl shadow-2xl transition-transform duration-500 scale-95" />
            </div>
        </div>

        <script>
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
            const closeBtn = document.getElementById('close-lightbox');
            const triggers = document.querySelectorAll('.lightbox-trigger');

            triggers.forEach(trigger => {
                trigger.parentElement?.addEventListener('click', () => {
                    const fullSrc = trigger.getAttribute('data-full-src');
                    if (fullSrc && lightbox && lightboxImg) {
                        lightboxImg.src = fullSrc;
                        lightbox.classList.remove('opacity-0', 'pointer-events-none');
                        setTimeout(() => {
                            lightboxImg.classList.remove('scale-95');
                            lightboxImg.classList.add('scale-100');
                        }, 10);
                        document.body.style.overflow = 'hidden';
                    }
                });
            });

            const closeLightbox = () => {
                if (lightbox && lightboxImg) {
                    lightboxImg.classList.add('scale-95');
                    lightboxImg.classList.remove('scale-100');
                    lightbox.classList.add('opacity-0', 'pointer-events-none');
                    document.body.style.overflow = '';
                    setTimeout(() => {
                        lightboxImg.src = '';
                    }, 300);
                }
            };

            closeBtn?.addEventListener('click', closeLightbox);
            lightbox?.addEventListener('click', (e) => {
                if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-content')) {
                    closeLightbox();
                }
            });

            // Close on escape
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeLightbox();
            });
        </script>
	</main>
</Layout>
