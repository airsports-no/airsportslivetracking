---
import Layout from '../layouts/Layout.astro';

const faqs = [
    {
        id: "REGISTRATION",
        question: "Registration in the APP does not work?",
        answer: "To authenticate the user in the APP, you must use an email that you have access to on your mobile phone. We use standard Google authentication and when you click on the link in the email, it will automatically verify and open the APP. The link can therefore not be accessed from a computer."
    },
    {
        id: "SUBSCRIPTION",
        question: "Subscription does not work?",
        answer: "The app’s subscription is managed by Apple Store or Google Play. If you get a new phone, restoring is simple if your account has an active subscription. Manage your subscription within your Apple Store or Google Play account to check its status or cancel it. If problems persist, try reinstalling the app."
    },
    {
        id: "ENTER",
        question: "How do I enter a competition?",
        answer: "First register to the competition. Open the Air Sports Live Tracking APP, go to the global map, find your competition. Select Manage crew, enter details, and schedule flight. You will receive a Flight Order with maps and photos after a few minutes."
    },
    {
        id: "DISAPPEARS",
        question: "My track/aircraft disappears from the map when I fly",
        answer: "Some phones stop battery access to apps in background mode. Make sure the app has 'Allow background activity' and 'Always allow location' enabled in your phone settings. Common on Huawei and OnePlus devices."
    },
    {
        id: "COMPETITIONS",
        question: "What kind of competitions are supported?",
        answer: "We support Precision Flying, Air Navigation Race (ANR), Air Sports Race, Danger Zone Race, Pilot Poker Run, and Landing Competitions."
    },
    {
        id: "MSFS2020",
        question: "Live tracking in Microsoft Flight Simulator 2020",
        answer: "You can fly competitions in MSFS2020! With a small add-on program, you can connect the simulator to Air Sports Live Tracking for training or virtual events."
    }
];
---

<Layout title="FAQ">
    <div class="max-w-4xl mx-auto px-4 py-20">
        <h1 class="text-4xl font-extrabold text-slate-900 mb-4">Frequently Asked Questions</h1>
        <p class="text-slate-600 mb-12 text-lg">Everything you need to know about getting started and troubleshooting.</p>
        
        <div class="space-y-4">
            {faqs.map(faq => (
                <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" id={faq.id}>
                    <button class="w-full text-left p-6 flex justify-between items-center group">
                        <span class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">{faq.question}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed border-t border-slate-50 pt-4 hidden">
                        {faq.answer}
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-20 p-8 bg-blue-50 rounded-3xl border border-blue-100 text-center">
            <h3 class="text-xl font-bold text-blue-900 mb-2">Still have questions?</h3>
            <p class="text-blue-700 mb-6 text-sm">We're here to help you get in the air.</p>
            <a href="mailto:support@airsports.no" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-full font-bold hover:bg-blue-700 transition-colors">
                Contact Support
            </a>
        </div>
    </div>

    <script>
        // Simple accordion logic
        document.querySelectorAll('button').forEach(button => {
            button.addEventListener('click', () => {
                const content = button.nextElementSibling;
                const isHidden = content.classList.contains('hidden');
                
                // Close all others
                document.querySelectorAll('div.text-slate-600').forEach(c => c.classList.add('hidden'));
                
                if (isHidden) {
                    content.classList.remove('hidden');
                }
            });
        });

        // Handle anchor links
        if (window.location.hash) {
            const id = window.location.hash.substring(1);
            const el = document.getElementById(id);
            if (el) {
                const btn = el.querySelector('button');
                const content = el.querySelector('div.text-slate-600');
                content.classList.remove('hidden');
                el.scrollIntoView();
            }
        }
    </script>
</Layout>
