---
import Layout from '../layouts/Layout.astro';

const videos = [
    { title: "ASLT in Action: 2022 Televised Competition", id: "jywBZyqcL1Q", anchor: "Promo2022" },
    { title: "How to use the mobile app for tracking", id: "h4OblJAbxzo", anchor: "MobileApp" },
    { title: "How to create a contest", id: "4ZPlDVjXabs", anchor: "CreateContest" },
    { title: "How to register for a contest", id: "mkVcg9KxRho", anchor: "SelfRegistration" },
];
---

<Layout title="Tutorials">
    <div class="max-w-5xl mx-auto px-4 py-20">
        <h1 class="text-4xl font-extrabold text-slate-900 mb-4 text-center">Video Tutorials</h1>
        <p class="text-slate-600 mb-16 text-lg text-center max-w-2xl mx-auto">Master the platform with our step-by-step video guides.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            {videos.map(video => (
                <div class="group" id={video.anchor}>
                    <div class="aspect-video bg-slate-200 rounded-3xl overflow-hidden shadow-lg group-hover:shadow-xl transition-all mb-6 relative">
                        <iframe 
                            class="absolute inset-0 w-full h-full"
                            src={`https://www.youtube.com/embed/${video.id}`}
                            title={video.title}
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen>
                        </iframe>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800">{video.title}</h3>
                </div>
            ))}
        </div>

        <div class="mt-32">
            <h2 class="text-3xl font-extrabold text-slate-900 mb-8 flex items-center gap-4">
                <span class="w-10 h-1 bg-blue-600 rounded-full"></span>
                Quick Start Guides
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <a href="/docs/09_Quick_Start_Poker_Run" class="group bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl hover:border-blue-300 transition-all">
                    <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2 uppercase italic tracking-tight font-lexend">Organizing a Poker Run</h3>
                    <p class="text-slate-500 text-sm leading-relaxed mb-4">Learn how to create routes, set up contests, and manage live social flying events.</p>
                    <span class="text-blue-600 font-bold text-xs uppercase tracking-widest flex items-center gap-2">
                        Read Tutorial 
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>

        <div class="mt-24 p-12 bg-indigo-900 text-white rounded-[3rem] text-center shadow-2xl shadow-indigo-200">
            <h2 class="text-3xl font-bold mb-6 italic italic">"Competition flying made easy."</h2>
            <p class="text-indigo-200 mb-8 max-w-xl mx-auto">
                Ready to take your flying to the next level? Explore our detailed written guides for in-depth information.
            </p>
            <a href="/docs/01_Introduction" class="inline-block bg-white text-indigo-900 px-8 py-3 rounded-full font-bold hover:bg-indigo-50 transition-all">
                Explore All Guides
            </a>
        </div>
    </div>
</Layout>
