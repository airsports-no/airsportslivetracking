---
import Layout from '../layouts/Layout.astro';

const videos = [
    { title: "How to create a contest", id: "4ZPlDVjXabs", anchor: "CreateContest" },
    { title: "How to register for a contest", id: "mkVcg9KxRho", anchor: "SelfRegistration" },
];
---

<Layout title="Tutorials">
    <div class="max-w-5xl mx-auto px-4 py-20">
        <h1 class="text-4xl font-extrabold text-slate-900 mb-4 text-center">Video Tutorials</h1>
        <p class="text-slate-600 mb-16 text-lg text-center max-w-2xl mx-auto">Master the platform with our step-by-step video guides.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            {videos.map(video => (
                <div class="group" id={video.anchor}>
                    <div class="aspect-video bg-slate-200 rounded-3xl overflow-hidden shadow-lg group-hover:shadow-xl transition-all mb-6 relative">
                        <iframe 
                            class="absolute inset-0 w-full h-full"
                            src={`https://www.youtube.com/embed/${video.id}`}
                            title={video.title}
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen>
                        </iframe>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800">{video.title}</h3>
                </div>
            ))}
        </div>

        <div class="mt-24 p-12 bg-indigo-900 text-white rounded-[3rem] text-center shadow-2xl shadow-indigo-200">
            <h2 class="text-3xl font-bold mb-6 italic italic">"Competition flying made easy."</h2>
            <p class="text-indigo-200 mb-8 max-w-xl mx-auto">
                Ready to take your flying to the next level? Explore our detailed written guides for in-depth information.
            </p>
            <a href="/docs/01_Introduction" class="inline-block bg-white text-indigo-900 px-8 py-3 rounded-full font-bold hover:bg-indigo-50 transition-all">
                Explore All Guides
            </a>
        </div>
    </div>
</Layout>
