---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import logoNoText from '../assets/img/airsports_no_text.png';

const { frontmatter, url } = Astro.props;

// Simple sidebar navigation based on your files
const navItems = [
    { title: "Introduction", slug: "/docs/01_Introduction", icon: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
    { title: "Contestant Guide", slug: "/docs/02_Contestant_Guide", icon: "M12 19l9 2-9-18-9 18 9-2zm0 0v-8" },
    { title: "Manager Guide", slug: "/docs/03_Contest_Manager_Guide", icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16" },
    { title: "Route Creation", slug: "/docs/04_Route_Creation_and_Tasks", icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m12 13l-5.447-2.724a1 1 0 01-.553-.894V5.618a1 1 0 011.447-.894L21 7" },
    { title: "Results Service", slug: "/docs/05_Results_Service_Guide", icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10" },
    { title: "Tracking Devices", slug: "/docs/06_Tracking_Devices", icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" },
    { title: "Scorecards", slug: "/docs/07_Competition_Types_and_Scorecards", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" },
    { title: "MSFS Integration", slug: "/docs/08_MSFS_Integration", icon: "M9.75 17L9 20l-2.25 1.5M14.25 17l.75 3 2.25 1.5M4.5 12h15M3 12a9 9 0 1118 0 9 9 0 01-18 0z" },
    { title: "Poker Run Setup", slug: "/docs/09_Quick_Start_Poker_Run", icon: "M4 16L4 4 16 4M4 16l4-4M4 16l4 4m8-4s-3 0-3-3 3-3 3-3 3 3-3 3-3 3z" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<Layout title={frontmatter.title || "Documentation"}>
    <div class="bg-slate-50 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
            <div class="flex flex-col xl:flex-row gap-12 xl:gap-20">
                <!-- Sidebar -->
                <aside class="xl:w-72 flex-shrink-0">
                    <div class="sticky top-32 space-y-8">
                        <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-xl shadow-slate-200/50">
                            <h5 class="font-extrabold text-slate-900 mb-8 uppercase tracking-[0.2em] text-[10px] italic flex items-center gap-2">
                                <span class="w-2 h-2 bg-blue-600 rounded-full"></span>
                                User Documentation
                            </h5>
                            <nav class="space-y-1">
                                {navItems.map(item => {
                                    const isActive = currentPath === item.slug;
                                    return (
                                        <a 
                                            href={item.slug} 
                                            class={`group flex items-center gap-4 px-4 py-3 rounded-2xl text-sm font-bold transition-all ${
                                                isActive 
                                                ? 'bg-blue-600 text-white shadow-lg shadow-blue-200 translate-x-2' 
                                                : 'text-slate-500 hover:bg-blue-50 hover:text-blue-600 hover:translate-x-1'
                                            }`}
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" class={`h-5 w-5 ${isActive ? 'text-blue-200' : 'text-slate-300 group-hover:text-blue-400'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                                            </svg>
                                            <span class="font-lexend tracking-tight uppercase italic">{item.title}</span>
                                        </a>
                                    )
                                })}
                            </nav>
                        </div>

                        <div class="bg-[#0F172A] rounded-[2rem] p-8 text-white shadow-2xl">
                            <p class="text-[10px] font-bold tracking-[0.2em] text-blue-400 uppercase mb-4 italic">Need Support?</p>
                            <p class="text-xs text-slate-400 leading-relaxed mb-6">
                                Can't find what you're looking for? Reach out to our community.
                            </p>
                            <a href="https://join.slack.com/t/airsportslivetracking/shared_invite/zt-2mmaui668-tEaJvJgoqg7782m3bdTleg" class="block text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-bold text-xs uppercase tracking-widest transition-all">
                                Join Slack
                            </a>
                        </div>
                    </div>
                </aside>

                <!-- Content Area -->
                <main class="flex-1">
                    <div class="bg-white rounded-[3rem] p-8 md:p-16 border border-slate-100 shadow-2xl shadow-slate-200/40 relative overflow-hidden">
                        <!-- Decorative Watermark -->
                        <div class="absolute -top-20 -right-20 opacity-[0.03] pointer-events-none select-none transform rotate-12">
                            <Image src={logoNoText} alt="" class="w-96 h-auto" width={400} height={400} />
                        </div>

                        <div class="relative z-10">
                            <div class="mb-12 flex items-center gap-4 text-xs font-bold text-blue-600/50 uppercase tracking-[0.3em] italic">
                                <a href="/" class="hover:text-blue-600 transition-colors">ASLT</a>
                                <span>/</span>
                                <span class="text-slate-400">Documentation</span>
                            </div>
                            
                            <article class="prose-custom">
                                <slot />
                            </article>

                            <div class="mt-24 pt-12 border-t border-slate-50 flex justify-between items-center">
                                <p class="text-xs text-slate-400 font-medium italic italic">Last updated: April 2024</p>
                                <a href="https://github.com/airsports-no/airsportslivetracking" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-2 uppercase tracking-widest">
                                    Edit on GitHub
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</Layout>
