# Copy to .env. Everything is optional.

# The site the tutorials are recorded on
TUTORIAL_BASE_URL=http://localhost:8002
# Where the browser says it is: a new route's map opens there ("latitude,longitude", for example 60.8,11.1). Used both
# when recording the clicks and the video. Empty: no location, the map opens at the editor's default.
TUTORIAL_GEOLOCATION=

# Narration: kokoro (local, free), openai or elevenlabs
TTS_PROVIDER=kokoro
# kokoro: af_heart, af_bella, am_michael, bf_emma, bm_george, ... (see node_modules/kokoro-js/voices)
# openai: coral, alloy, ash, sage, verse, ...    elevenlabs: a voice id
TTS_VOICE=
TTS_SPEED=1
# openai only: how the voice should sound
TTS_INSTRUCTIONS=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# The page size the tutorials are recorded at (16:9; default 1440x810). Used both when recording the clicks
# (windows/codegen.ps1) and the video, so they always match. A bigger page gives more room; text looks a little smaller
# in the video.
TUTORIAL_WIDTH=
TUTORIAL_HEIGHT=

# Extra pause Playwright makes before every browser operation (ms), usually not needed
TUTORIAL_SLOWMO=0
