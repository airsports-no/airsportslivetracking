# Copy to .env. Everything is optional.

# The site the tutorials are recorded on
TUTORIAL_BASE_URL=http://localhost:8002
# Where the browser says it is: a new route's map opens there. Use the same value as -Geolocation when recording the
# clicks on Windows, or map clicks land elsewhere. Empty: no location, the map opens at the editor's default.
TUTORIAL_GEOLOCATION=

# Narration: kokoro (local, free), openai or elevenlabs
TTS_PROVIDER=kokoro
# kokoro: af_heart, af_bella, am_michael, bf_emma, bm_george, ... (see node_modules/kokoro-js/voices)
# openai: coral, alloy, ash, sage, verse, ...    elevenlabs: a voice id
TTS_VOICE=
TTS_SPEED=1
# openai only: how the voice should sound
TTS_INSTRUCTIONS=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Pause the recording makes before each browser action (ms): time for the drawn cursor to travel
TUTORIAL_SLOWMO=350
