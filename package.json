{
  "scripts": {
    "build:react": "cd react_vite && npm run build",
    "build:marketing": "cd airsports_static && npm run build",
    "build:all": "npm run build:react && npm run build:marketing",
    "watch:react": "cd react_vite && npm run build -- --watch",
    "test:react": "cd react_vite && npm test",
    "watch:marketing": "cd airsports_static && npm run dev -- --host",
    "watch:all": "npx concurrently \"npm run watch:react\" \"npm run watch:marketing\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "daisyui": "^5.7.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
